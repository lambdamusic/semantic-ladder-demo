#!/usr/bin/env bash
# The experiment's web pages on http://127.0.0.1:8030. Every page reads the repo's files
# when it opens, so new runs show up on reload. Uses the semantics-ladder env if it exists.
PY=~/Envs/semantics-ladder/bin/python
[ -x "$PY" ] || PY=~/Envs/credit-graph-lab-2026/bin/python
cd "$(dirname "$0")/.." && exec "$PY" src/web/manage.py runserver 127.0.0.1:${PORT:-8030} "$@"
